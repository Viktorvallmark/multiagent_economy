; ********************************************************************************************************************************************************
; ***          household.NLS  (contains all the code for the household)                                                                                ****
; *********************************************************************************************************************************************************
; DESCRIPTION OF THE AGENT
; - Hybrid two-pass
; - 1.uppdatera environment
; - 2.kör proactive del (pass 1 uppåt)
; - 3.kör reactive del (pass 2 neråt)

; Just nu - income från firm, skickar till government får tillbaks lön efter tax. ANNARS en satt tax rate sen få tillbaks om du betalat för lite eller om du behöver betala in?

; INTE LAGT TILL SÅ ATT STORE ÄR FIRM EGENTLIGEN
;*********************************************************************************************************************************************************
; LOCAL VARIABLES
households-own [
  ; --- variabler från reaktiv del ---
  wealth              ; hushållets pengar (ersätter wealth)
  income             ; senaste lönen
  pension-savings    ; sparade pensionspengar
  financial-state    ; FSM: "har-pengar", "har-lite-pengar", "har-inga-pengar"
  spending-limit     ; max att spendera (budget som styr)
  
  ; --- variabeler från proaktiv del ---
  proState ; "Proaktiva FSM "Stable", "Saving", "Stocking-up"
  pension-goal ; målet för pensionen
  prev-total-price ; förra tickens totala pris på food + supplies
  price-trend ; positiv --> priserna går upp, negativ <-- priser går ner
  
  ; --- variabler från firm integration ---
  productivity
  employer     ;antingen employer eller employed? inte båda (said får bestämma det)
  employed?
  unemployed-time
  offered-income ; lönen som erbjuds i job offer
  reservation-income
  warning-count
  happiness
  
  food-amount
  supplies-amount
  food-stock
  food-price
  supplies-stock
  supplies-price
  should-purchase?
  
  productivity-bonus
  
  ; variabler för att få bort proaktiv från reaktiva meddelanden, bättre arkitektur
  pending-job-offer?
  pending-offer-income
  pending-offering-firm
  pending-warning?
  pending-warning-threshold
  
] 

to setup-household ; det som händer när man trycker "setup" knappen i interfacet
  
  create-households 10 [ ; skapar 10 hushåll
    set incoming-queue []

    set wealth 50 + random 50 ; random startpengar för variation
    set income 0 ; lön
    set pension-savings 0 ; börjar med inget pensionsparande
    set spending-limit 999 ; inte lagt någon budget gräns
    set financial-state "har-pengar" ; FSM startar i "har-pengar" läget

    set employer nobody
    set employed? false
    set unemployed-time 0
    set offered-income 0
    set reservation-income (productivity * 2) ; "ta jobbet gränsen" på lön baseras på hur "duktig" household är 
    set warning-count 0

    set productivity 2 + random 4
    set happiness 50

    set food-stock 0
    set food-price 0
    set supplies-stock 0
    set supplies-price 0
    
    set pending-job-offer? false
    set pending-offer-income 0
    set pending-offering-firm nobody
    set pending-warning? false
    set pending-warning-threshold 0
    
    
    ; --- proaktiva initial värdena --- 
    set proState "Stable" ; startar i normal ekonomisk situation
    set pension-goal 750
    set prev-total-price food-price + supplies-price ; start totalpris
    set price-trend 0 ; startar inte med någon trend i pris
    
    ; --- Interface inställningar ---
    set shape "person" ; person symbol på kartan
    set color green ; grön = har pengar
    set size 2 ; storlek på personen
    setxy random-xcor random-ycor ; random spawn på personen
  ]
end

; PASS 1 UPPÅT--- Observera världen o uppdatera variabler
to updateEnvironmentInfo_households
  set should-purchase? (ticks mod 7 != 0)

  ; Läs igenom alla meddelanden
  while [not empty? incoming-queue] [

    let msg get-message
    let performative get-performative msg
    let content get-content msg
    let msg-type item 0 content

    ;; ---------------- PROPOSE MESSAGES ----------------
    if performative = "propose" [

      ;; TAX REBATE
      if msg-type = "tax-rebate" [
        let amount item 1 content
        receive-money amount
      ]

      ; JOB OFFER 
      if msg-type = "job-offer" [
        set pending-job-offer? true
        set pending-offer-income item 1 content
        set pending-offering-firm item 2 content
        print (word "Tick " ticks ": Household " who " accepterade jobb offret")
        
        ; offer för bargaining? ska det vara här? -10% av goverment aid?
      ]
      
      ; GOVERNMENT AID
      if msg-type = "aid" [
        let amount item 1 content ; Mängden pengar; 
        
        receive-money amount
        print (word "Tick " ticks ": Household " who " tog emot " amount " kr i bidrag. ")
      ]
      
      ;; JOB-SEEKING ENCOURAGEMENT FROM GOVERNMENT
      ;if msg-type = "seek-work" [
        ; happiness
      ;]
    ]
  
    ;; ---------------- INFORM MESSAGES ----------------
    if performative = "inform" [

      ; PAYCHECK
      if msg-type = "paycheck" [
        let amount item 1 content
        let old-income income ; previous salary
        set income amount
        receive-money amount
        
        if income != old-income [
          set pension-goal income * 30 ; updated pension goal
        ]
      ]

      ; PRODUCTIVITY WARNING
      if msg-type = "productivity-warning" [
        set pending-warning? true
        set warning-count warning-count + 1
        set happiness happiness - random 11 ; varnad, mindre glad, randomizer för att sänka happiness samt öka productivity. Får in en threshold sen under o över den random.
        
        set pending-warning-threshold item 1 content
      ]

      ; FIRED
      if msg-type = "fired" [
        set employer nobody
        set employed? false
        set income 0
        set warning-count 0
        
        set happiness happiness - 25 ; blir sparkad, minskar glädjen

        print (word "Tick " ticks ": Household " who " got fired")
      ]
      
      ;; REKLAMBLAD
      if msg-type = "store-advertisement" [
        let firm-who item 1 content
        set food-stock item 2 content
        set supplies-stock item 3 content
        set food-price item 4 content
        set supplies-price item 5 content
      ]

      if msg-type = "order-approved" [
        let firm-who item 1 content
        let order-food-amount item 2 content
        let order-supply-amount item 3 content
        let order-cost item 4 content

        set wealth wealth - order-cost
        ; set happiness happiness + 3
      ]

      if msg-type = "order-denied" [
        let firm-who item 1 content
        set should-purchase? true
        ; set happiness happiness - 3
      ]
    ]
  ]

  ifelse not employed? [
    set unemployed-time unemployed-time + 1
  ] [
    set unemployed-time 0
  ]

  
  ; LÄGG TILL SATISFACTION REPORT NÅGONSTANS HÄR
  ; räknar ut pristrend
  let current-total food-price + supplies-price
  set price-trend current-total - prev-total-price
  set prev-total-price current-total
  
  ; uppdatera financial state
  update-financial-state
  
  ; uppdatera produktivitet
  update-productivity
  
end

; --- Bestämma strategi, FSM 3 states, proState som reactive använder sen ---
to proactive_households
  
   evaluate-messages-proactively
  ; FSM
  if proState = "Stable" [
    ; pensionsmål ej nått --> spara
    if pension-savings < pension-goal [
      set proState "Saving"
      stop
    ]
    ; pristrend uppåt --> stocka upp
    if price-trend > 3 [
      set proState "Stocking-up"
      stop
    ]
  ]
  
  if proState = "Saving" [
    ; pensionsmål nått --> Stable
    if pension-savings >= pension-goal [
      set proState "Stable"
      stop
    ]
    ; pristrend uppåt --> stocka upp
    if price-trend > 3 [
      set proState "Stocking-up"
      stop
    ]
  ]
  
  if proState = "Stocking-up" [
    ; normal pristrend --> checka pensionsmål för state
    if price-trend <= 1 [
      ifelse pension-savings >= pension-goal [
        set proState "Stable"
      ] [
        set proState "Saving"
      ]
      stop
    ]
  ]
end

; PASS 2 NERÅT
to reactive_households

  ;; Lager 1 — sätt budget utifrån financial-state
  budget-household
  if spending-limit <= 0 [ stop ]

  ;; Lager 2 — handla
  limit-purchases

  ;; Lager 3 — pensionssparande
  save-pension

end
; --- ENVIRONMENT FUNKTIONER--- 

to update-financial-state
  ifelse wealth > 50 [
    set financial-state "har-pengar"
    set color green ; grön = bra pengarsituation
    set happiness happiness + 0.1 ; ökar happiness om "har-pengar"
  ] [
    ifelse wealth > 0 [
      set financial-state "har-lite-pengar"
      set color yellow ; gul = tight pengarsituation
      ; happiness stannar samma i denna state
    ] [
      set financial-state "har-inga-pengar"
      set wealth 0 ; så en household inte kan få minus pengar (kanske vill ha minus om man implementerar lån?)
      set color red ; röd = inga pengar
      set happiness happiness - 0.5 ; minskar happiness om "har-inga-pengar"
    ]
  ]
end


; uppdaterar productivity baserat på happiness och pengar-state
to update-productivity
  if happiness > 70 [
    set productivity productivity + 0.1
  ]
  if happiness < 30 [
    set productivity productivity - 0.1
  ]
  
  if financial-state = "har-pengar" [
    set productivity productivity - 0.1
  ]
  if financial-state = "har-inga-pengar" [
    set productivity productivity + 0.2
  ]
  
  ; spärrar så det funkar med hårdkodade värden for now
  if productivity > 5 [set productivity 5]
  if productivity < 1 [set productivity 1]
  if happiness > 100 [set happiness 100]
  if happiness < 0 [set happiness 0]
end

; --- REACTIVE FUNKTIONER ---
to receive-money [amount] ; sätt in pengar på kontot
  set wealth wealth + amount
  set happiness happiness + ((amount / income) * 5) ; får pengar, glädje ökar
end

to budget-household ; budgetterar pengarna för hushållet
  if financial-state = "har-pengar" [
    set spending-limit wealth * 0.4 ; spenderar 40%
  ]
  if financial-state = "har-lite-pengar" [
    set spending-limit wealth * 0.2 ; spenderar 20% pga tajt ekonomi
  ]
  if financial-state = "har-inga-pengar" [
    set spending-limit 0 ; inga pengar, inget o budgettera med
    
    let msg create-message "request"
    set msg add-content (list "household-need-aid" who) msg
    
    if any? governments [
      set msg add-receiver [who] of one-of governments msg
      send msg
    ]
  ]
end

to limit-purchases
  if not should-purchase? [stop] ; gör inget om inte handlingsdag
  if food-price = 0 or supplies-price = 0 [stop] ; kan inte köpa om priset är 0 (inte fått reklamblad än)

  if proState = "Stocking-up" [
    set spending-limit spending-limit * 1.5
  ]
  
  ; if proState = "Saving" [
  ;   set spending-limit food-price
  ; ]

  let food-wanted floor ((spending-limit * 0.75) / food-price)
  let supplies-wanted floor ((spending-limit * 0.25) / supplies-price)
  let total-cost (food-wanted * food-price) + (supplies-wanted * supplies-price)
  
  if total-cost = 0 [stop] ; Inte lönt att köpa ingenting

  let msg create-message "request"
  set msg add-content (list "purchase-order" who food-wanted supplies-wanted total-cost) msg
  set msg add-receiver [who] of one-of firms msg
  send msg
  
  ; let total-cost food-price + supplies-price ; kostnad för handlingen

  ; ifelse total-cost > spending-limit [ ; inte råd med båda
  ;   ifelse food-price <= spending-limit [ ; finns pengar till mat
  ;     set wealth wealth - food-price 
  ;     set happiness happiness - 1 ; mindre glad pga. köp bara mat
  ;   ] [
      ; Inga pengar för ens mat, köp inget
  ;     set happiness happiness - 5 ; köpte inget, inte glad
  ;   ]
  ; ] [
    ; råd med båda
  ;   set wealth wealth - total-cost ; köp allt
  ;   set happiness happiness + 1 ; köper båda, blir gladare
  ; ]
end

to save-pension ; pensionssparande
  if financial-state != "har-pengar" [stop] ; pensionssparar bara om man har pengar till det
  if (ticks mod 30 != 0) [stop] ; sparar bara om 30:e dag, alltså varje månad

  let pension-rate 0.1
  if proState = "Saving" [
    set pension-rate 0.2
  ]
  
  let pension-contribution wealth * pension-rate 
  if pension-contribution > 1 [ ; inte lönt o spara mindre än 1 kr
    set wealth wealth - pension-contribution ; tar bort pengar från nuvarande pengar pga spara
    set pension-savings pension-savings + pension-contribution ; lägger till sparandet i nuvarande pensionssparande
  ]
end

to evaluate-messages-proactively
  if pending-job-offer? [
    if not employed? and pending-offer-income >= reservation-income [
      set employer pending-offering-firm
      set employed? true
      set income pending-offer-income
      set pension-goal income * 30
      
      let reply create-message "accept-proposal"
      set reply add-content (list "job-accepted" self) reply
      set reply add-receiver [who] of pending-offering-firm reply
      send reply
      
      print (word "Tick " ticks ": Household " who " proactively evaluated and accepted job offer")
    ]
    set pending-job-offer? false
    set pending-offer-income 0
    set pending-offering-firm nobody
  ]
  
  if pending-warning? [
    let threshold pending-warning-threshold
    
    set productivity productivity + round(threshold * 0.5 + random-float 1)
    
    let reply create-message "inform"
    set reply add-content (list "warning-acknowledged" self) reply
    set reply add-receiver [who] of employer reply
    send reply
    
    print (word "Tick " ticks ": Household " who " proactively processed warning and adjusted productivity")
    
    set pending-warning? false
    set pending-warning-threshold 0
  ]
end
