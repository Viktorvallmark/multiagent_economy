;================================
; Imports
;================================


; =======================================================================================================================================================
; OBSERVER COORDINATION FOR FIRM / HOUSEHOLD / GOVERNMENT MODEL
; =======================================================================================================================================================


to update-world

  ; update firm memory and demand
  ask firms [
    set last-profit profit
    set last-demand demand

    set demand demand + random 5 - random 5

    if demand < 0 [
      set demand 0
    ]
  ]

  ; movement and display are controlled by observer
  move-employed-households
  update-worker-visibility-observer

end


to update-profits-lists
  
  set unprofitable-firms-list [self] of firms with [ profit < 0 ]
  set profitable-firms-list [self] of firms with [ profit > 0 ]
  
end

to check-economic-conditions
  
  let ratio 0
  
  if count households > 0 [
    
    set ratio (length unemployment-list) / count households
    
  ]
  update-profits-lists
  
  let avg-wealth mean [wealth] of households
  
  ifelse ratio > 0.7 and avg-wealth < 10000 and  (length profitable-firms-list < length unprofitable-firms-list) [
      
    set economic-crisis true
      
  ][
    set economic-crisis false
  ]
  
end


to update-unemployment-list

  set unemployment-list [self] of households with [not employed?]
  
end

to update-worker-visibility-observer

  ask firms [

    if chosen-method = "household" [
      ask households with [employer = myself and employed?] [
        show-turtle
      ]

      ask machine-workers with [employer = myself] [
        hide-turtle
      ]
    ]

    if chosen-method = "machine" [
      ask households with [employer = myself and employed?] [
        hide-turtle
      ]

      ask machine-workers with [employer = myself] [
        show-turtle
      ]
    ]
  ]
end

; not used rn? didnt work like wanted
to update-average-income  ; bara för hushållen som jobbar
  ifelse count households with [employed? = true] > 0 [
  set average-income mean [income] of households with [employed? = true]
  print(word "From Observer, Average income: " average-income)
  ] [
    set average-income 0
    print(word "No one with income, set to 0 ")
  ]
end
