; ============================================================
; GOVERNMENT HYBRID AGENT TEST ; GOVERNMENT NEW
; Plan:
;   PROACTIVE: Decide what to do based on environment
;   REACTIVE:  Fire action
; ============================================================

governments-own [ 
  gov-budget                ; Statens budget, vi får in skatt och lägger in det här, sedan delar vi eventuellt ut pengar.
  spending                  ; Informationsvariabel som håller koll på hur mycket vi har spenderat på skatteåterbäring   
  redistribution-rate       ; Rate variabel: Hur "generösa" government är vid återbäring. Desto högre desto högre bidrag får hushållen.
  observed-firm-profit      ; Variabel som innehåller mängden profit från firm.
  observed-household-wage   ; Variabel som innehåller mängden wage från household.
  observed-firm-tax         ; Beräknad avdragen skatt från firm.
  observed-household-tax    ; Beräknad avdragen skatt från household.
  planned-tax-rate-firms
  planned-tax-rate-households
  chosen-action
  households-needing-aid
  firms-needing-aid
  firms-wanting-expansion
  expansion-decisions
  household-aid-decisions
  firm-aid-decisions
  redistribution-decisions
  household-satisfaction
]


to setup-government
  
  create-governments 1 [
    set household-satisfaction []
    set households-needing-aid []
    set firms-needing-aid []
    set firms-wanting-expansion []
    set incoming-queue []
    set expansion-decisions []
    set household-aid-decisions []
    set firm-aid-decisions []
    set redistribution-decisions []
    set gov-budget 0
    set spending 0
    set redistribution-rate 0.2
    set shape "house"
    set color white
    set size 3
    setxy 10 10
  ]
  
end

; ============================================================
; READ ENVIRONMENT
; ============================================================
to updateEnvironmentInfo_government
  
  ; --- Hämta meddelanden ---
  while [not empty? incoming-queue] [
    let msg get-message
    let performative get-performative msg
    let content get-content msg
    let msg-type item 0 content
    
    if performative = "inform" [

      if msg-type = "satisfaction-report" [
        let household-who item 1 content
        let happiness-received item 2 content
        set household-satisfaction lput (list household-who happiness-received) household-satisfaction
      ]
    ]
    
    if performative = "request" [
      if msg-type = "want-to-expand" [
        let firm-who item 1 content
        let expansion-budget item 2 content
        let expected-production item 3 content
        set firms-wanting-expansion lput (list firm-who ) firms-wanting-expansion
      ]
      if msg-type = "household-need-aid" [
        let household-who item 1 content
        set households-needing-aid lput (list household-who) households-needing-aid
      ]
      if msg-type = "firm-need-aid" [
        let firm-who item 1 content
        let requested-firm-money item 2 content
        set firms-needing-aid lput (list firm-who requested-firm-money) firms-needing-aid
      ]
    ]
  ]
  
  ; --- Hämta info från firm och household ---
  set observed-firm-profit     [profit] of one-of firms
  set observed-household-wage  [income]   of one-of households ; 1 hushåll eller flera?
  
  ; --- Observera skattepengar från firm och household ---
  set observed-firm-tax      observed-firm-profit     * tax-rate-firms
  set observed-household-tax observed-household-wage  * tax-rate-households
  
  set gov-budget gov-budget + observed-firm-tax + observed-household-tax
  
end


; ============================================================
; GOVERNMENT HYBRID AGENT
; PROACTIVE LAYER
; ============================================================
to proactive_government                                                   ; GLÖM INTE: KOLLA SATSERNAS PRIORITET OCH PLACERING
  ; --- Kolla invånarnas tillfredsställelse ---
  if not empty? household-satisfaction [
    foreach household-satisfaction [
      current-household ->
      let current-household-who item 0 current-household
      let current-household-happiness item 1 current-household
      ifelse current-household-happiness > 80 [                                                   ;KOLLA TRÖSKELVÄRDE
        ; print ("Household happy")                                                ;VAD SKA GÖRAS NÄR HUSHÅLL ÄR NÖJD? STOPP?
      ] [
        ; print ("Household not happy")                                            ;VAD SKA GÖRAS NÄR HUSHÅLL ÄR MISSNÖJD? KOPPLING TILL POLICY CHANGE?
      ]
    ]
  ]
  
  
  ; --- Sätt flagga om det finns företag i behov av utökning ---
  if not empty? firms-wanting-expansion [
    
    foreach firms-wanting-expansion [
      current-firm ->
      let current-firm-who item 0 current-firm
      let current-expansion-budget item 1 current-firm
      let current-expected-production item 2 current-firm
      ifelse current-expansion-budget >= 10000 and current-expected-production >= 100 [             ;KOLLA TRÖSKELVÄRDEN
        set expansion-decisions lput (list current-firm-who "approved-expansion") expansion-decisions
      ] [
        set expansion-decisions lput (list current-firm-who "denied-expansion") expansion-decisions
      ]
    ]
    set chosen-action "evaluate-expansion"
    stop
  ]
  


  
  ; --- Sätt flagga om det finns hushåll i behov av ekonomiskt bistånd ---
  if not empty? households-needing-aid [
    let aid-amount 20                                                                 ;KOLLA AMOUNT
    foreach households-needing-aid [
      current-household ->
      let current-household-who item 0 current-household
      set household-aid-decisions
      lput (list current-household-who aid-amount)
      household-aid-decisions
    ]
    set chosen-action "give-household-aid"
    stop
  ]
  
  ; --- Sätt flagga om det finns företag i behov av ekonomiskt bistånd ---
  if not empty? firms-needing-aid [
    foreach firms-needing-aid [
      current-firm ->
      let current-firm-who item 0 current-firm
      let current-firm-money item 1 current-firm
      ifelse current-firm-money < 500 [
        set firm-aid-decisions
        lput (list current-firm-who 100 "approved")                               ;KOLLA AMOUNT
        firm-aid-decisions
      ] [
        set firm-aid-decisions
        lput (list current-firm-who 0 "denied")
        firm-aid-decisions
      ]
    ]
    set chosen-action "give-firm-aid"
    stop
  ]
  
  ; --- Sätt flagga om budgeten överstiger tröskel för återbäring ---
  if gov-budget > 2000 and ticks mod year = 0 [                                                            ;KOLLA TRÖSKELVÄRDE
    let rebate gov-budget * redistribution-rate
    let per-household rebate / count households
    foreach [who] of households [
      household-who ->
      set redistribution-decisions
      lput (list household-who per-household)
      redistribution-decisions
    ]
    set chosen-action "redistribute"
    stop
  ]
  
  ; --- Beräkna lämplig skattesats för firm ---
  let new-firm-tax-rate 0
  ifelse observed-firm-profit > 100 [                                           ;KOLLA TRÖSKELVÄRDE
    set new-firm-tax-rate 0.30
  ] [
    ifelse observed-firm-profit > 50 [                                          ;KOLLA TRÖSKELVÄRDE
      set new-firm-tax-rate 0.20
    ] [
      set new-firm-tax-rate 0.10
    ]
  ]
  
  ; --- Beräkna lämplig skattesats för household ---
  let new-household-tax-rate 0
  ifelse observed-household-wage > 20 [                                         ;KOLLA TRÖSKELVÄRDE
    set new-household-tax-rate 0.30
  ] [
    ifelse observed-household-wage > 10 [                                        ;KOLLA TRÖSKELVÄRDE
      set new-household-tax-rate 0.20
    ] [
      set new-household-tax-rate 0.10
    ]
  ]
  
  ; --- Spara beräknade skattesatser ---
  set planned-tax-rate-firms      new-firm-tax-rate
  set planned-tax-rate-households new-household-tax-rate
  set chosen-action "adjust-tax"
  
end

; ============================================================
; GOVERNMENT HYBRID AGENT
; REACTIVE LAYER
; ============================================================
to reactive_government                                                    ; GLÖM INTE: KOLLA SATSERNAS PRIORITET OCH PLACERING
  ; --- Satisfaction report---
  ; SKRIV KOD HÄR
  
  ; --- Evaluera utökande av företag ---
  if chosen-action = "evaluate-expansion" [
    foreach expansion-decisions [
      decision ->
      let firm-who item 0 decision
      let outcome item 1 decision
      let msg create-message "inform"
      set msg add-content (list outcome) msg
      set msg add-receiver firm-who msg
      send msg
    ]
    set firms-wanting-expansion []
    set expansion-decisions []
    stop
  ]
  
  ; --- Dela ut ekonomiskt bistånd till fattiga hushåll ---
  if chosen-action = "give-household-aid" [
    foreach household-aid-decisions [
      decision ->
      let household-who item 0 decision
      let aid-amount item 1 decision
      if gov-budget >= (aid-amount * 10) [
        let msg create-message "propose"
        set msg add-content (list "social-aid" aid-amount) msg
        set msg add-receiver household-who msg
        send msg
        set gov-budget gov-budget - aid-amount
      ]
    ]
    set households-needing-aid []
    set household-aid-decisions []
    stop
  ]
  
  ; --- Dela ut ekonomiskt bistånd till fattiga företag ---
  if chosen-action = "give-firm-aid" [
    foreach firm-aid-decisions [
      decision ->
      let firm-who item 0 decision
      let aid-amount item 1 decision
      let outcome item 2 decision
      let msg create-message "inform"
      set msg add-content (list outcome aid-amount) msg
      set msg add-receiver firm-who msg
      send msg
      if outcome = "approved" [
        set gov-budget gov-budget - aid-amount
      ]
    ]
    set firms-needing-aid []
    set firm-aid-decisions []
    stop
  ]
  
  ; --- Distribuera återbäring om flaggan är sann ---                     ; SKA DET VARA 1 GÅNG PER 365 TICK?
  if chosen-action = "redistribute" [
    foreach redistribution-decisions [
      decision ->
      let household-who item 0 decision
      let rebate-amount item 1 decision
      let msg create-message "propose"
      set msg add-content (list "tax-rebate" rebate-amount) msg
      set msg add-receiver household-who msg
      send msg
    ]
    let total-rebate sum map [d -> item 1 d] redistribution-decisions
    set gov-budget gov-budget - total-rebate
    set redistribution-decisions []
    stop
  ]
end
