;; firm variables
firms-own [
  production
  revenue
  income-cost
  offered-income
  machine-cost
  tax-paid
  profit
  firm-money
  last-profit
  price
  chosen-method
  demand
  last-demand
  expected-demand
  target-production
  current-production
  max-capacity
  productivity-threshold
  warned-households
]

;; HOUSEHOLDS-OWN must include:
;; wage
;; productivity
;; employer
;; employed?
;; reservation-wage
;; warning-count

machine-workers-own [
  productivity
  employer
  maintenance-cost
]

to setup-firm

  create-firms 1 [
    set incoming-queue []
    set shape "square"
    set color blue
    set size 4
    setxy 50 50

    set production 0
    set revenue 0
    set income-cost 0
    set offered-income 5
    set machine-cost 0
    set tax-paid 0
    set profit 0
    set firm-money 500
    set last-profit 0
    set price 10
    set chosen-method "household"

    set demand 20
    set last-demand 20
    set expected-demand 20
    set target-production 20
    set current-production 0
    set max-capacity 100
    set productivity-threshold 2
    set warned-households []
  ]


  create-machine-workers 4 [
    set shape "square"
    set color gray
    set size 1.5
    set maintenance-cost 3
    set productivity 8

    let my-firm one-of firms
    set employer my-firm
    move-to my-firm
    rt random 360
    fd random 20
  ]

end

to reactive-firm

  ask firms [
    calculate-production
    set current-production production

    calculate-revenue
    calculate-wages
    calculate-machine-cost
    calculate-tax
    calculate-profit
 if ticks > 0 and ticks mod 30 = 0 [
  send-paychecks
]
    ;; listen for acknoweledgement of warning
    while [not empty? incoming-queue] [
  let msg get-message
  let performative get-performative msg
  let content get-content msg
  let msg-type item 0 content

  if performative = "inform" and msg-type = "warning-acknowledged" [
    let household-id item 1 content

    if not member? household-id warned-households [
      set warned-households lput household-id warned-households
    ]

    print (word "Tick " ticks ": Firm received warning acknowledgement from household " household-id)
  ]
]
  ]
  

end

to proactive-firm

  ask firms [
    decide-dynamic-price
    decide-production-amount
    decide-investment-method
    decide-fire-hire
    request-expansion
    request-aid

    if ticks mod 5 = 0 [
      print (word
        "Tick: " ticks
        " | Price: " price
        " | Prod: " production
        " | Target: " target-production
        " | Demand: " demand
        " | Profit: " profit
        " | Government money: " governemnt-money
      )
    ]
  ]

end

to calculate-production



  let household-output sum [productivity] of households with [
    employer = myself and employed?
  ]

  let machine-output sum [productivity] of machine-workers with [
    employer = myself
  ]

  ;; actual firm production uses both humans + machines
  set production household-output + machine-output


end

to decide-investment-method

  let household-productivity 2
  let machine-productivity 8

  ;; if equal → choose human
  ifelse household-productivity >= machine-productivity [
    set chosen-method "household"
  ] [
    set chosen-method "machine"
  ]

end

to calculate-revenue
  set revenue production * price
end

to calculate-wages
  let my-households households with [employer = myself and employed?]
  set income-cost sum [wage] of my-households
end

to calculate-machine-cost
  let my-machines machine-workers with [employer = myself]
  let variable-cost sum [maintenance-cost] of my-machines

  if any? my-machines [
    set machine-cost variable-cost + machine-fixed-cost
  ]

  if not any? my-machines [
    set machine-cost 0
  ]
end

to calculate-tax
  set tax-paid revenue * tax-rate-firms
  set governemnt-money governemnt-money + tax-paid
end

to calculate-profit
  set profit revenue - income-cost - machine-cost - tax-paid
  set firm-money firm-money + profit
end

to send-job-offer-to-all

  let candidates households with [not employed? and employer = nobody]

  if any? candidates [
    let msg create-message "propose"

    set msg add-content (list "job-offer" offered-income self) msg
    set msg add-multiple-receivers [who] of candidates msg

    send msg

    print (word "Tick " ticks ": Firm sent job offer to "
      count candidates " households. Wage: " offered-income)
  ]

end

to send-paychecks

  let employed-workers households with [
    employer = myself and employed?
  ]

  if any? employed-workers [
    let msg create-message "inform"

    ;; message = type, paycheck amount
    set msg add-content (list "paycheck" wage) msg
    set msg add-multiple-receivers [who] of employed-workers msg

    send msg

    print (word "Tick " ticks ": Firm sent paycheck to "
      count employed-workers " households. Amount: " offered-income)
  ]

end

to request-expansion

  ;; if production is maxed out and firm has enough money
  if production >= max-capacity and firm-money >= 10000 [

    let msg create-message "request"

    ;; content = type, requested expansion amount
    set msg add-content (list "expansion-request" firm-money production) msg

    let gov one-of governments
    set msg add-receiver [who] of gov msg

    send msg

    print (word
      "Tick " ticks
      ": Firm requested expansion from government"
    )
  ]

end
to request-aid

  ;; if firm money is dangerously low
  if firm-money < 500 [

    let msg create-message "request"

    set msg add-content (list "aid-request" firm-money) msg
     
    let gov one-of governments
    set msg add-receiver [who] of gov msg
    send msg

    print (word
      "Tick " ticks
      ": Firm requested financial aid from government"
    )
  ]

end
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to decide-dynamic-price

  if demand > production [
    set price price + 1
  ]

  if demand < production [
    set price price - 1
  ]

  if price < 1 [
    set price 1
  ]

end

to decide-production-amount

  set expected-demand (0.7 * demand + 0.3 * last-demand)

  set target-production expected-demand

  let household-capacity sum [productivity] of households with [employer = myself and employed?]
  let machine-capacity sum [productivity] of machine-workers with [employer = myself]

  set max-capacity household-capacity + machine-capacity

  if profit > last-profit [
    set target-production target-production + 3
  ]

  if profit < last-profit [
    set target-production target-production - 3
  ]

  if target-production > max-capacity [
    set target-production max-capacity
  ]

  if target-production < 0 [
    set target-production 0
  ]

end

to decide-fire-hire

  let current-household-workers count households with [employer = myself and employed?]
  let current-machines count machine-workers with [employer = myself]

  let max-household-workers 50
  let max-machines 20

  ;; hire households by sending job offer messages
  if target-production > current-production [
    if chosen-method = "household" and current-household-workers < max-household-workers [
      send-job-offer-to-all
    ]

    if chosen-method = "machine" and current-machines < max-machines [
      print (word "Tick " ticks ": BUYING machine worker")

      hatch-machine-workers 1 [
        set employer myself
        set color gray
        set shape "square"
        set size 1.5
        set maintenance-cost 3
        set productivity 8
        rt random 360
        fd 15
      ]
    ]
  ]

  ;; productivity warning / firing
  check-household-productivity

  ;; sell machine if production target is lower and profit decreased
  if chosen-method = "machine" and target-production < current-production and profit < last-profit [
    if current-machines > 1 [
      let machine-to-sell one-of machine-workers with [employer = myself]

      if machine-to-sell != nobody [
        print (word "Tick " ticks ": SELLING machine worker")
        ask machine-to-sell [ die ]
      ]
    ]
  ]

end

to check-household-productivity

  let low-workers households with [
    employer = myself and
    employed? and
    productivity < [productivity-threshold] of myself
  ]

  if any? low-workers [
    let worker one-of low-workers
    let worker-id [who] of worker

    ifelse member? worker-id warned-households
    [
      ;; second time low productivity + warning acknowledged = fire
      let fire-msg create-message "inform"
      set fire-msg add-content (list "fired") fire-msg
      set fire-msg add-receiver worker-id fire-msg
      send fire-msg

      set warned-households remove worker-id warned-households

      print (word "Tick " ticks ": Firm fired household " worker-id " after warning")
    ]
    [
      ;; first time low productivity = warning
      let warning-msg create-message "inform"
      set warning-msg add-content (list "productivity-warning") warning-msg
      set warning-msg add-receiver worker-id warning-msg
      send warning-msg

      print (word "Tick " ticks ": Firm sent productivity warning to household " worker-id)
    ]
  ]

end



