;; firm variables
firms-own [
  money
  revenue
  expenses
  profit

  last-revenue
  last-expenses
  profit-history

  food-stock
  supplies-stock
  food-price
  supplies-price

  demand
  demand-history

  income-cost
  machine-cost
  total-costs

  production
  offered-income
  tax-paid
  chosen-method
  chosen-action
  expected-demand
  max-capacity
  productivity-threshold
  warned-households
  employed-households
  productivity-reports
  
  max-household-workers
  max-machines
  current-capacity

  received-tax-rate
  tax-ready?
]

;; HOUSEHOLDS-OWN must include:
;; income
;; productivity
;; employer
;; reservation-income
;; warning-count

machine-workers-own [
  productivity
  employer
]

to setup-firm

  create-firms 1 [
    set incoming-queue []
    set shape "square"
    set color blue
    set size 4
    setxy 50 50

    set production 0
    set revenue 0
    set income-cost 0
    set offered-income 5
    set machine-cost 0
    set total-costs 0

    set profit 0
    set profit-history (list 0)
    set money 1000
    set chosen-method "household"
    set chosen-action "none"

    set demand 0
    set demand-history []
    set expected-demand 20

    set productivity-threshold 2
    set warned-households []
    set employed-households []
    set productivity-reports []
    set food-stock 100
    set supplies-stock 100
    set food-price 0.1
    set supplies-price 0.1
    set received-tax-rate 0
    set tax-ready? false
    set max-household-workers 50
    set max-machines 20
    set max-capacity 100
    set current-capacity 0
  ]

end

