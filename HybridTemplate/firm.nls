to decide-offered-income

  ; offered income is based on demand and productivity threshold, but lowballed
  set offered-income (food-price * month + supplies-price * month * 0.25) * 0.5

end

to update-environment-firm
  if demand < 0 [
    set demand 0
  ]

  set demand-history lput demand demand-history
  if length demand-history > (year / 2) [
    set demand-history but-first demand-history
  ]
  set demand (mean demand-history) / 1.5

end

