to send-advertisement [receivers]

  let msg create-message "inform"

  set msg add-content
    (list
      "store-advertisement"
      self
      food-stock
      supplies-stock
      food-price
      supplies-price
    )
    msg

  set msg add-multiple-receivers receivers msg

  send msg

  print (word
    "Tick " ticks
    ": Firm sent store advertisement to households"
  )

end

to fire-household [household-who]

  let fire-msg create-message "inform"
  set fire-msg add-content (list "fired") fire-msg
  set fire-msg add-receiver [who] of household-who fire-msg
  send fire-msg

  set warned-households remove household-who warned-households
  set employed-households filter [h -> item 0 h != household-who] employed-households
  set productivity-reports filter [r -> item 0 r != household-who] productivity-reports

  print (word "Tick " ticks ": Firm fired household " household-who)

end

to earn-money [amount]

  set money money + amount
  set revenue revenue + amount

end

to spend-money [amount]

  set money money - amount
  set expenses expenses + amount

end