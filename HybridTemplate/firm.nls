to calculate-production

  ;; calculate household production from reports
  let household-output 0

  foreach productivity-reports [

    r ->

    set household-output
      household-output + item 1 r
  ]

  ;; machine production
  let machine-output sum [productivity] of machine-workers with [
    employer = myself
  ]

  ;; total production
  set production household-output + machine-output

end

to create-store-products

  ;; convert production into stock
  set food-stock food-stock + floor production / 2
  set supplies-stock supplies-stock + floor production / 2

end


to decide-investment-method
  let household-productivity 8

  if not empty? productivity-reports [
    set household-productivity mean map [r -> item 1 r] productivity-reports
  ]

  let machine-productivity 8

  let per-household-cost-yearly offered-income * 12
  let per-machine-cost-yearly machine-fixed-cost + (machine-maintenance-cost + machine-tax) * 12

  let household-productivity-per-cost household-productivity / max (list 1 per-household-cost-yearly)
  let machine-productivity-per-cost machine-productivity / max (list 1 per-machine-cost-yearly)

  let mean-recent-profit mean (sublist profit-history max (list 0 (length profit-history - 2)) length profit-history)
  ifelse demand > production * 1.2 and mean-recent-profit >= total-costs [
    set chosen-action "hire"

    ifelse household-productivity-per-cost >= machine-productivity-per-cost [
      set chosen-method "household"
    ] [
      set chosen-method "machine"
    ]
  ] [
    ifelse mean-recent-profit < 0 [
      set chosen-action "fire"

      ifelse household-productivity-per-cost < machine-productivity-per-cost [
        set chosen-method "household"
      ] [
        set chosen-method "machine"
      ]
    ] [
      set chosen-action "none"
    ]
  ]

end

