to request-tax-rate
  let gov one-of governments

  let msg create-message "request"
  set msg add-content (list "tax-rate-request" who profit) msg
  set msg add-receiver [who] of gov msg
  send msg
end


to send-job-offer

  let non-candidates map [h -> item 0 h] employed-households
  let candidates households with [
    not member? self non-candidates
  ]

  if any? candidates [
    let chosen-household one-of candidates

    let msg create-message "propose"

    set msg add-content (list "job-offer" offered-income self) msg
    set msg add-receiver [who] of chosen-household msg

    send msg

    print (word
      "Tick " ticks
      ": Firm sent job offer to "
      chosen-household
      ". income: "
      offered-income
    )
  ]
end
to send-paychecks

  if not empty? employed-households [

    foreach employed-households [

      current-household ->

      let household-who item 0 current-household
      let household-income item 1 current-household

      let msg create-message "inform"


      set msg add-content
        (list "paycheck" household-income) msg

      set msg add-receiver [who] of household-who msg

      send msg

      spend-money household-income
    ]

    print (word
      "Tick " ticks
      ": Firm sent individual paychecks to "
      length employed-households
      " households."
    )
  ]

end

to request-expansion

  ;; if production is maxed out and firm has enough money
  if production >= max-capacity and money >= 10000 [

    let msg create-message "request"

    ;; content = type, requested expansion amount
    set msg add-content (list "want-to-expand" who money production) msg

    let gov one-of governments
    set msg add-receiver [who] of gov msg

    send msg

        print (word "Tick " ticks ": Firm requested expansion from government")
  ]

end

to request-aid

  ;; if firm money is dangerously low
  if money < 500 [

    let msg create-message "request"

    set msg add-content (list "firm-need-aid" who money) msg

    let gov one-of governments
    set msg add-receiver [who] of gov msg
    send msg

       print (word "Tick " ticks ": Firm requested financial aid from government")
  ]

end

to recieve-tax-rate
    let msg get-message
    let performative get-performative msg
    if performative = "inform" [
        let content get-content msg
        let receive-tax-rate item 1 content
        set received-tax-rate receive-tax-rate
    ]

end

to pay-tax

  if tax-ready? [
    let machine-list [self] of machine-workers with [
      employer = myself
    ]

    set tax-paid profit * received-tax-rate + machine-tax * length machine-list

    let gov one-of governments

    let msg create-message "inform"
    set msg add-content (list "tax-payment" who tax-paid) msg
    set msg add-receiver [who] of gov msg
    send msg

    spend-money tax-paid
    set tax-ready? false
  ]

end
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to decide-production-amount

  let last-demand last demand-history
  let last-demand-trend 0
  if length demand-history > 1 [
    set last-demand-trend last-demand - item (length demand-history - 2) demand-history
  ]
  set expected-demand demand + last-demand-trend

  ;; household capacity from received productivity reports
  let household-capacity 0

  foreach productivity-reports [
    f ->
    set household-capacity household-capacity + item 1 f
  ]

  ;; machine capacity from machines
  let machine-capacity sum [productivity] of machine-workers with [
    employer = myself
  ]

  set current-capacity household-capacity + machine-capacity

  ;; dynamic productivity threshold
  set productivity-threshold 2 + (expected-demand - current-capacity) / 10
  if productivity-threshold < 1 [
    set productivity-threshold 1
  ]

end

to decide-fire-hire

  let current-household-workers count households with [
    employer = myself
  ]

  let current-machines count machine-workers with [
    employer = myself
  ]

  let mean-recent-profit mean (sublist profit-history max (list 0 (length profit-history - 2)) length profit-history)
  print(word "Production: " production " | Demand: " demand " | Household workers: " current-household-workers " | Machines: " current-machines " | Total costs: " total-costs " | Last mean profit: " mean-recent-profit)
  if chosen-action = "hire" [
    if chosen-method = "household" and current-household-workers < max-household-workers [
      send-job-offer
    ]

    if chosen-method = "machine" and current-machines < max-machines [

      print (word "Tick " ticks ": BUYING machine worker")

      hatch-machine-workers 1 [
        set employer myself
        set color gray
        set shape "square"
        set size 1.5
        set productivity 8
        rt random 360
        fd 15
      ]

      spend-money machine-fixed-cost
    ]
  ]

  if chosen-action = "fire" [

    ; if no workers to fire, stop.
    if current-machines = 0 and current-household-workers = 0 [ stop ]
    if chosen-method = "machine" and current-machines = 0 [
      set chosen-method "household"
    ]
    if chosen-method = "household" and current-household-workers = 0 [
      set chosen-method "machine"
    ]

    if chosen-method = "machine" [
      let machine-to-sell one-of machine-workers with [
        employer = myself
      ]

      if machine-to-sell != nobody [
        print (word "Tick " ticks ": SELLING machine worker")
        ask machine-to-sell [ die ]
      ]
    ]

    if chosen-method = "household" [
      let most-expensive-household nobody
      let highest-income 0
      foreach employed-households [
        h ->
        let household-who item 0 h
        let household-income item 1 h
        if household-income > highest-income [
          set highest-income household-income
          set most-expensive-household household-who
        ]
      ]

      if most-expensive-household != nobody [
        fire-household most-expensive-household
      ]
    ]
  ]

end
