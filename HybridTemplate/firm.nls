;; firm variables
firms-own [
  production
  revenue
  income-cost
  offered-income
  machine-cost
tax-paid
  profit
  firm-money
  last-profit
  price
  chosen-method
  demand
  last-demand
  expected-demand
  target-production
  current-production
  max-capacity
  productivity-threshold
  warned-households
  employed-households
  productivity-reports
  food-stock
  supplies-stock
  production-stock
  food-price
supplies-price
  store-revenue
  pre-tax-income
  received-tax-rate
  tax-ready?
  max-household-workers
  max-machines
  current-capacity
]

;; HOUSEHOLDS-OWN must include:
;; income
;; productivity
;; employer
;; reservation-income
;; warning-count

machine-workers-own [
  productivity
  employer
  maintenance-cost
]

to setup-firm

  create-firms 1 [
    set incoming-queue []
    set shape "square"
    set color blue
    set size 4
    setxy 50 50

    set production 0
    set revenue 0
    set income-cost 0
    set offered-income 5
    set machine-cost 0

    set profit 0
    set firm-money 500
    set last-profit 0
    set price 10
    set chosen-method "household"

    set demand 20
    set last-demand 20
    set expected-demand 20
    set target-production 20

    set productivity-threshold 2
    set warned-households []
    set employed-households []
    set productivity-reports []
    set food-stock 0
    set supplies-stock 0
    set production-stock 0
    set food-price 5
    set supplies-price 3
    set store-revenue 0
    set pre-tax-income 0
    set received-tax-rate 0
    set tax-ready? false
    set max-household-workers 50
    set max-machines 20
    set max-capacity 100
    set current-capacity 0
    set current-production 0
  ]


 create-machine-workers 4 [
    set shape "square"
    set color gray
    set size 1.5
    set maintenance-cost 3
    set productivity 8

    let my-firm one-of firms
    set employer my-firm
    move-to my-firm
    rt random 360
    fd random 20
  ]

end

to reactive-firm

  calculate-production
  set current-production production
  create-store-products


  if ticks > 0 and ticks mod 30 = 0 [
    send-paychecks
  ]

  while [not empty? incoming-queue] [

    let msg get-message
    let performative get-performative msg
    let content get-content msg
    let msg-type item 0 content

  ;; if warning sent
    if performative = "inform" and msg-type = "warning-acknowledged" [

      let household-id item 1 content

      if not member? household-id warned-households [
        set warned-households lput household-id warned-households
      ]

      print (word "Tick " ticks ": Firm received warning acknowledgement from household " household-id)
    ]

    ;; if expanison denied
    if performative = "inform" and msg-type = "denied-expansion" [
      print (word "Tick " ticks ": Firm expansion request was denied by government")
    ]
    ;; counter expansion
    if performative = "propose" and msg-type = "partial-expansion" [

  let expansion-amount item 1 content

  ifelse expansion-amount >= 5 [

    set max-capacity max-capacity + expansion-amount
    set max-household-workers max-household-workers + 5
    set max-machines max-machines + 5

    let reply create-message "accept-proposal"
    set reply add-content (list "expansion-accepted" expansion-amount) reply
    set reply add-receiver [who] of one-of governments reply
    send reply

    print (word "Firm accepted partial expansion: " expansion-amount)

  ] [

    let reply create-message "propose"
    set reply add-content (list "counter-expansion-request" who 10) reply
    set reply add-receiver [who] of one-of governments reply
    send reply

    print "Firm counter-offered expansion request: 10"
  ]
]

   ;; if expansion approved
    if performative = "inform" and msg-type = "approved-expansion" [
            print (word "Tick " ticks ": building new firm")

             set max-capacity max-capacity + 10
             set max-household-workers max-household-workers + 5
             set max-machines max-machines + 5

      print (word
        "Tick " ticks
        ": Firm expansion request was approved by government. New max-capacity: "
        max-capacity
      )
    ]
      ;; if aid sent
    if performative = "propose" and msg-type = "aid" [

  let aid-amount item 1 content

  ifelse aid-amount >= 300 [

    set firm-money firm-money + aid-amount

    let reply create-message "accept-proposal"
    set reply add-content (list "aid-accepted" aid-amount) reply
    set reply add-receiver [who] of one-of governments reply
    send reply

    print (word "Firm accepted government aid: " aid-amount)

  ] [

    let reply create-message "propose"
    set reply add-content (list "counter-aid-request" who 500) reply
    set reply add-receiver [who] of one-of governments reply
    send reply

    print "Firm counter-offered aid request: 500"
  ]
]
    ;; if jobb acceptefd
    if performative = "accept-proposal" and msg-type = "job-accepted" [

  let household-who item 1 content

  if not member? household-who employed-households [
    set employed-households lput household-who employed-households
  ]
]

    if performative = "propose" and msg-type = "counter-job-offer" [

  let household-id item 1 content
  let requested-income item 2 content

  ifelse requested-income <= offered-income + 2 [

    let reply create-message "accept-proposal"
    set reply add-content (list "counter-accepted" requested-income) reply
    set reply add-receiver household-id reply
    send reply

    if not member? household-id employed-households [
      set employed-households lput household-id employed-households
    ]

    print (word "Firm accepted counter offer from household " household-id)

  ] [

    let reply create-message "inform"
    set reply add-content (list "counter-rejected") reply
    set reply add-receiver household-id reply
    send reply

    print (word "Firm rejected counter offer from household " household-id)
  ]
]
      ;; recieve productivity level
    if performative = "inform" and msg-type = "productivity-level" [

  let household-id item 1 content
  let reported-productivity item 2 content

  ;; remove old report from same household
  set productivity-reports filter [r -> item 0 r != household-id] productivity-reports


  ;; add newest report
  set productivity-reports
    lput (list household-id reported-productivity)
    productivity-reports

;   print (word
;     "Tick " ticks
;     ": Firm received productivity "
;     reported-productivity
;     " from household "
;     household-id
;   )
]

    ;; if order okay

    if performative = "request" and msg-type = "purchase-order" [

  let buyer-id item 1 content
  let food-wanted item 2 content
  let supplies-wanted item 3 content
  let money-sent item 4 content

  if food-stock >= food-wanted and supplies-stock >= supplies-wanted [

    set food-stock food-stock - food-wanted
    set supplies-stock supplies-stock - supplies-wanted

    ;;set firm-money firm-money + money-sent
      set store-revenue store-revenue + money-sent

    let reply create-message "inform"
    set reply add-content (list "order-approved" food-wanted supplies-wanted money-sent) reply
    set reply add-receiver buyer-id reply
    send reply

    print (word
      "Tick " ticks
      ": Firm approved order from household "
      buyer-id
      ". Food: " food-wanted
      " Supplies: " supplies-wanted
      " Money received: " money-sent
    )
  ]

  ;; if order cant be made
if food-stock < food-wanted or supplies-stock < supplies-wanted [

  let reply create-message "inform"
  set reply add-content (list "order-denied") reply
  set reply add-receiver buyer-id reply
  send reply

  ;; remember that demand was higher than stock
  set demand demand + food-wanted + supplies-wanted
  set target-production target-production + food-wanted + supplies-wanted

  ;; calculate how much stock was missing
let missing-food max (list 0 (food-wanted - food-stock))
let missing-supplies max (list 0 (supplies-wanted - supplies-stock))

let total-missing missing-food + missing-supplies

;; produce at least the missing amount
set production-stock production-stock + total-missing

;; convert production into products immediately
create-store-products

  print (word
    "Tick " ticks
    ": Firm denied order from household "
    buyer-id
    " because stock was too low. Firm increased production planning."
  )
]
]
    ;; recieve tax rate
    if performative = "inform" and msg-type = "tax-rate" [

  set received-tax-rate item 1 content
  set tax-ready? true

;   print (word "Firm received tax rate: " received-tax-rate)
]

  ]

  calculate-revenue
  calculate-incomes
  calculate-machine-cost
  request-tax-rate
  pay-tax

end

to proactive-firm

  decide-dynamic-price
  update-store-prices
  decide-production-amount
  decide-investment-method
  decide-offered-income
  decide-fire-hire
  request-expansion
  request-aid

 if ticks > 0 and ticks mod 7 = 0 [
  send-advertisement
]
;   if ticks mod 5 = 0 [
;     print (word
;       "Tick: " ticks
;       " | Price: " price
;       " | Prod: " production
;       " | Target: " target-production
;       " | Demand: " demand
;       " | Profit: " profit
;       " | Government money: " governemnt-money
;     )
;   ]

end

to calculate-production

  ;; calculate household production from reports
  let household-output 0

  foreach productivity-reports [

    r ->

    set household-output
      household-output + item 1 r
  ]

  ;; machine production
  let machine-output sum [productivity] of machine-workers with [
    employer = myself
  ]

  ;; total production
  set production household-output + machine-output
  set production-stock production-stock + production

end

to decide-investment-method

  let household-productivity 0

  if not empty? productivity-reports [
    set household-productivity mean map [r -> item 1 r] productivity-reports
  ]

  let machine-productivity 8

  ifelse household-productivity >= machine-productivity [
    set chosen-method "household"
  ] [
    set chosen-method "machine"
  ]

end

to calculate-revenue
  set revenue store-revenue

end

to calculate-incomes

  let my-households households with [
    employer = myself
  ]

  set income-cost sum [income] of my-households

end

to calculate-machine-cost

  let my-machines machine-workers with [
    employer = myself
  ]

  let variable-cost sum [maintenance-cost] of my-machines

  if any? my-machines [
    set machine-cost variable-cost + machine-fixed-cost
  ]

  if not any? my-machines [
    set machine-cost 0
  ]

end

to temp-tax

  set pre-tax-income revenue - income-cost - machine-cost

  let gov one-of governments

  let msg create-message "request"
  set msg add-content (list "tax-rate-request" who pre-tax-income) msg
  set msg add-receiver [who] of gov msg
  send msg

end


to send-job-offer-to-all

  let candidates households with [
    employer = nobody
  ]

  if any? candidates [

    let msg create-message "propose"

    set msg add-content (list "job-offer" offered-income self) msg
    set msg add-multiple-receivers [who] of candidates msg

    send msg

    print (word
      "Tick " ticks
      ": Firm sent job offer to "
      count candidates
      " households. income: "
      offered-income
    )
  ]

end
to send-paychecks

  if not empty? employed-households [

    foreach employed-households [

      household-id ->

      let current-household turtle household-id

      let msg create-message "inform"

      set msg add-content
        (list "paycheck" [income] of current-household) msg

      set msg add-receiver household-id msg

      send msg
    ]

    print (word
      "Tick " ticks
      ": Firm sent individual paychecks to "
      length employed-households
      " households."
    )
  ]

end
to request-expansion

  ;; if production is maxed out and firm has enough money
  if production >= max-capacity and firm-money >= 10000 [

    let msg create-message "request"

    ;; content = type, requested expansion amount
    set msg add-content (list "want-to-expand" who firm-money production) msg

    let gov one-of governments
    set msg add-receiver [who] of gov msg

    send msg

        print (word "Tick " ticks ": Firm requested expansion from government")
  ]

end
to request-aid

  ;; if firm money is dangerously low
  if firm-money < 500 [

    let msg create-message "request"

    set msg add-content (list "firm-need-aid" who firm-money) msg

    let gov one-of governments
    set msg add-receiver [who] of gov msg
    send msg

       print (word "Tick " ticks ": Firm requested financial aid from government")
  ]

end

to create-store-products

  let conversion min (list production-stock 10)

  let food-made conversion / 2
  let supplies-made conversion / 2

  set food-stock food-stock + food-made
  set supplies-stock supplies-stock + supplies-made

  set production-stock production-stock - conversion

end

to request-tax-rate

    let msg create-message "request"
    set msg add-content (list "request-tax-rate" who profit) msg
    let gov one-of governments
    set msg add-receiver [who] of gov msg
    send msg
end


to recieve-tax-rate
    let msg get-message
    let performative get-performative msg
    if performative = "inform" [
        let content get-content msg
        let receive-tax-rate item 1 content
        set received-tax-rate receive-tax-rate
    ]

end



to pay-tax

  if tax-ready? [

    set tax-paid pre-tax-income * received-tax-rate
    set profit pre-tax-income - tax-paid
    set firm-money firm-money + profit

    let gov one-of governments

    let msg create-message "inform"
    set msg add-content (list "tax-payment" who tax-paid) msg
    set msg add-receiver [who] of gov msg
    send msg
    set store-revenue 0

    set tax-ready? false
  ]

end
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to decide-dynamic-price

  if demand > production [
    set price price + 1
  ]

  if demand < production [
    set price price - 1
  ]

  if price < 1 [
    set price 1
  ]

end

to decide-production-amount

  set expected-demand (0.7 * demand + 0.3 * last-demand)

  set target-production expected-demand

  ;; household capacity from received productivity reports
  let household-capacity 0

  foreach productivity-reports [
    f ->
    set household-capacity household-capacity + item 1 f
  ]

  ;; machine capacity from machines
  let machine-capacity sum [productivity] of machine-workers with [
    employer = myself
  ]

set current-capacity household-capacity + machine-capacity

  if profit > last-profit [
    set target-production target-production + 3
  ]

  if profit < last-profit [
    set target-production target-production - 3
  ]

  ;; dynamic productivity threshold
if demand > production [
  set productivity-threshold productivity-threshold + 1
]

if demand < production [
  set productivity-threshold productivity-threshold - 1
]

;; minimum threshold
if productivity-threshold < 1 [
  set productivity-threshold 1
]
; maximum threshold
if productivity-threshold > 10 [
  set productivity-threshold 10
]

  if target-production > current-capacity [
  set target-production current-capacity
]

  if target-production < 0 [
    set target-production 0
  ]

end

to decide-fire-hire

  let current-household-workers count households with [
    employer = myself
  ]

  let current-machines count machine-workers with [
    employer = myself
  ]


  if target-production > current-production [

    if chosen-method = "household" and current-household-workers < max-household-workers [
      send-job-offer-to-all
    ]

    if chosen-method = "machine" and current-machines < max-machines [

      print (word "Tick " ticks ": BUYING machine worker")

      hatch-machine-workers 1 [
        set employer myself
        set color gray
        set shape "square"
        set size 1.5
        set maintenance-cost 3
        set productivity 8
        rt random 360
        fd 15
      ]
    ]
  ]

  check-household-productivity

  if chosen-method = "machine"
     and target-production < current-production
     and profit < last-profit [

    if current-machines > 1 [

      let machine-to-sell one-of machine-workers with [
        employer = myself
      ]

      if machine-to-sell != nobody [
        print (word "Tick " ticks ": SELLING machine worker")
        ask machine-to-sell [ die ]
      ]
    ]
  ]

end
to check-household-productivity

  ;; loop trough each report
  foreach productivity-reports [

    ? -> ;; temporary variable

      ;; store worker id
    let worker-id item 0 ?
    ;; store worker productivity
    let reported-productivity item 1 ?

    if reported-productivity < productivity-threshold [
       ;; if worker has been warned before
      ifelse member? worker-id warned-households [

        ;; second time low productivity + acknowledged warning = fire
        let fire-msg create-message "inform"

        set fire-msg add-content (list "fired") fire-msg
        set fire-msg add-receiver worker-id fire-msg

        send fire-msg

        set warned-households remove worker-id warned-households
        set employed-households remove worker-id employed-households

        print (word
          "Tick " ticks
          ": Firm fired household "
          worker-id
          " after low productivity report"
        )

      ] [

        ;; first time low productivity = warning
        let warning-msg create-message "inform"

        set warning-msg add-content (list "productivity-warning" productivity-threshold) warning-msg
        set warning-msg add-receiver worker-id warning-msg

        send warning-msg

        print (word
          "Tick " ticks
          ": Firm sent productivity warning to household "
          worker-id
        )
      ]
    ]
  ]

end

to update-demand

  ;; price to high low demand
  if price > 15 [
    set demand demand - 2
  ]
    ;; price low high demand
  if price < 8 [
    set demand demand + 2
  ]

  ;; firm cant produce enough
  if production < demand [
    set demand demand + 1
  ]

  ;; firm produces to little
  if production > demand [
    set demand demand - 1
  ]

  ;; if profit is improving
  if profit > last-profit [
    set demand demand + 1
  ]
    ;; if profit getting worse
  if profit < last-profit [
    set demand demand - 1
  ]

  ;; small randomness
  set demand demand + random 3 - random 3

  ;; keep demand from going below zero
  if demand < 0 [
    set demand 0
  ]

end

to decide-offered-income

  ;; base offer
  set offered-income 5

  ;; if production target is higher than current production, offer more
  if target-production > current-production [
    set offered-income offered-income + 2
  ]

  ;; if firm has enough money, it can offer more
  if firm-money > 1000 [
    set offered-income offered-income + 1
  ]

  ;; if firm money is low, reduce offer
  if firm-money < 300 [
    set offered-income offered-income - 1
  ]

  ;; if profit is improving, offer a bit more
  if profit > last-profit [
    set offered-income offered-income + 1
  ]

  ;; if profit is getting worse, offer a bit less
  if profit < last-profit [
    set offered-income offered-income - 1
  ]

  ;; minimum offer
  if offered-income < 1 [
    set offered-income 1
  ]

end

to update-environment-firm

  set last-profit profit
  set last-demand demand

  update-demand

end

to update-store-prices

  set food-price price * 1.5
  set supplies-price price * 1.2

end

to send-advertisement

  let msg create-message "inform"

  set msg add-content
    (list
      "store-advertisement"
      food-stock
      supplies-stock
      food-price
      supplies-price
    )
    msg

  set msg add-multiple-receivers [who] of households msg

  send msg

  print (word
    "Tick " ticks
    ": Firm sent store advertisement to households"
  )

end

