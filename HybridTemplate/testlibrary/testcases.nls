; ; ********************************************************************************************************************************************************
; ;***          testcases.nls  (contains the code for the speciic testfunctions)                                                                                    ****
; ;*********************************************************************************************************************************************************
; ; TEST-CASE VERSION NUMMER: TC02
; ;*********************************************************************************************************************************************************
; ; DESCRIPTION OF THE TESTCASE
; ; - The testcase creates two specific agents:
; ;              - "wolf" as agentA, double normal size
; ;              - "sheep" as agentB, double the normal size
; ; - The testcase overrides the setup values and update_environment_info for "wolf" by forcing moveFlag=false and followFlag=true. It also sets
; ;   friendList, friend and follower to the "sheep" agentB.
; ;   As a consequence, "wolf" is following "sheep" which identifies "wolf" as stalker and escapes into sanctuary. 
; ; - The simulation run is terminated when "sheep" is successfully escaping to sanctuary
; ; - The monitor-functions monitor_wolf and monitor_sheep save the changes in the agent-specific variables into 
; ;   the text file "BasicTemplate-testcase_TC01.txt"
; ;*********************************************************************************************************************************************************
; ;*********************************************************************************************************************************************************
; ; LOGBOOK OF UPDATES IN THIS FILE
; ; --Date--- |-----Description--------------------------------------------------------------------------------|---Person(s)-------------------------------
; ; 20260304    Initial testcase with a wolf for agentA and a sheep for agentB                                     Gion
; ; 20260506  | Testcase for the Distribute welfare behaviour                                                  |   Nicolas, Mimoza
; ;
; ;
; ;********************end logbook ************************************************************************************************************************


; ;*********************************************************************************************************************************************************
; ; GLOBAL VARIABLES ONLY FOR TEST CASES
; ; do not include it in globals.nls
globals [
  
  
]
; ; government-specific variables for the test case
; ; do not include in the agents declaration files
governments-own [
  test-initial-budget
  test-redistribute-rate
  test-tax-rate
]

; ; household-specific variables for the test case
; ; do not include in the agents declaration files
households-own [
  test-initial-wealth
  test-income
  test-financial-state
  test-spending-limit
]

; ; firm-specific variables for the test case
; ; do not include in the agents declaration files
firms-own [
  test-firm-money
  test-food-stock
  test-supplies-stock
  test-demand-history
  
]
; ;*********************************************************************************************************************************************************

to setup-test-government
  
  set test-initial-budget 2500
  set test-redistribute-rate 0.2
  set test-tax-rate 0
  
  
  
end

; ;*********************************************************************************************************************************************************
; ; Testfunctions to be called in the to-go part, 
; ; after the ask turtles, in the observer-section 
; ;

;;;;;;;;;;;;;;;;;;;;;;;;;;;;; GOVERNMENT TESTS ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to monitor-government-test
  
  ;; Test 1: Testing the distribute-welfare procedure
  
  ;;Outcomes: Pass - Government budget decreased by tax-rebate. Fail - Government budget didnt decrease
  let temp 0
  if test-initial-budget > 2000 [     
    set temp test-initial-budget
    let rebate test-initial-budget * test-redistribute-rate
    let per-household rebate / count households
    set test-initial-budget test-initial-budget - per-household
    
  ]
  if temp < test-initial-budget [
    error("Budget didn't decrease from tax rebate")
  ]
  print(word "Test 1 PASSED")
  
  
  ;; Test 2: Testing tax-rate algorithm
  ;; Outcomes: Pass - Correct tax rate was chosen. Fail - Wrong tax rate was chosen
  
  let household-income 1000
  
  ifelse household-income >= 1000 [
    set test-tax-rate 0.3
  ][
    set test-tax-rate 0.1
  ]
  
  if test-tax-rate = 0.1 [
    error("Wrong tax rate")
  ]
  if test-tax-rate = 0.3 [
    
    print(word "Correct tax rate chosen")
  ]
  
  ;; Test 3: Testing tax rebate
  ;; Outcomes: Pass - Can sense when there is nothing to reimburse. Fail - Reimburses even though no budget
  
  if test-initial-budget - (test-initial-budget * test-redistribute-rate) < 2000 [
    
    error ("Can't distribute below threshold")
    
  ]
  print(word "Test 3 PASSED")
  

end

; ;****************** end specific testfunctions in agent's code *************************************************************************************************

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; FIRM TESTS ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to setup-firm-test
  set test-firm-money 5
  set test-food-stock 5
  set test-supplies-stock 5
  set test-demand-history [3 4 5]
end

to monitor-firm-test
  
  
  ;; Test 1 - Testing updating store price procedure
  ;; Outcomes - Pass: Updates price in the store correctly. Fail: Wrong prices
  
  let test-food-price 5 * (1 + ((mean demand-history) - test-food-stock) / 20)
  let test-supplies-price 3 * (1 + ((mean demand-history) - test-supplies-stock) / 20)

  if food-price < 0.1 [
    set food-price 0.1
  ]
  if supplies-price < 0.1 [
    set supplies-price 0.1
  ]
  
  if test-food-price != (5 * (1 + ((mean demand-history) - test-food-stock) / 20)) [
    
    error("Wrong calculation updating food prices")
    
  ]
  
  if test-supplies-price != (3 * (1 + ((mean demand-history) - test-supplies-stock) / 20)) [
    error("Wrong calculation updating supplies price")
  ]
  
  
  ;; Test 2 - Test getting aid is ok
  ;; Outcomes - Pass: Aid is correctly added Fail - wrong calculations with aid
  
  
  let test-aid-amount 300
  
  set test-firm-money test-firm-money + test-aid-amount
  
  if test-aid-amount != 305 [
    
    error("Wrong amount of test-firm-money")
  ]
  
  
  
  
  
end

;;;;;;;;;;;;;;;;;;;;;;; HOUSEHOLD TESTS ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;


to setup-household-test
  set test-initial-wealth 100
  set test-financial-state 0
  set test-spending-limit 0
  
  
end

to monitor-household-test
  
  ;; Test 1 - Testing proper financial state when doing update-financial-state
  ;; Outcomes - Pass: correct financial state is set. Fail: wrong financial state is set.
  
    ifelse test-initial-wealth >= 50 [
    set test-financial-state "har-pengar"

  ] [
    ifelse test-initial-wealth > 0 and wealth < 50 [
      set financial-state "har-lite-pengar"

    ] [
      set test-financial-state "har-inga-pengar"
      set test-initial-wealth 0 
    ]
  ]
  
  if test-initial-wealth >= 50 and test-financial-state != "har-pengar" [
    
    error("Wrong financial state")
    
  ]
  
    if test-initial-wealth < 50 and test-initial-wealth > 0 and test-financial-state = "har-pengar" [
    
    error("Wrong financial state")
    
  ]
  
  if test-initial-wealth <= 0 and test-financial-state = "har-pengar" [
    error("Wrong financial state")
  ]
  
  ;; Test 2 - Testing spending limit
  ;; Outcomes - Pass: Correct spending limit set depending on wealth. Fail: Wrong spending limit chosen
  
  if test-financial-state = "har-pengar" [
    set test-spending-limit test-initial-wealth * 0.4 
  ]
  if test-financial-state = "har-lite-pengar" [
    set test-spending-limit test-initial-wealth * 0.2 
  ]
  if test-financial-state = "har-inga-pengar" [
    set test-spending-limit 0 
  ]
  
  
  set test-financial-state "har-pengar"
  
  if test-spending-limit != (test-initial-wealth * 0.4) [
    
    error("Wrong spending limit")
    
  ]
  
  set test-financial-state "har-lite-pengar"
  
  if test-spending-limit != (test-initial-wealth * 0.2) [
    
    error("Wrong spending limit")
    
  ]
  
  set test-financial-state "har-inga-pengar"
  
  if test-spending-limit != 0 [
    
    error("Wrong spending limit")
    
  ]
  
  ;; Test 3 - Testing pension saving
  ;; Outcomes - Pass: Saving for pension in correct financial state. Fail: Saving in wrong financial state
  
  if test-financial-state != "har-pengar" [
    
    error("Can't save in wrong financial state")
  ]

end


;; Wrapper functions that executes all tests when pushing to GitHub
to test-government-run
  setup-test-government
  monitor-government-test
end

to test-firm-run
  setup-firm-test
  monitor-firm-test
end

to test-household-run
  setup-household-test
  monitor-household-test
end



