; GLOBAL VARIABLES
globals [
  ; ------------- Sliders
  ; Number_AgentA
  ; Number_AgentB
  
  ; ------------- Variables
  
  ; Observer variables
  economic-crisis       ; Shit hits the fan variable
  unemployment-list   ; List of unemployed households
  profitable-firms-list ; List of profitable firms
  unprofitable-firms-list ; List of unprofitable firms
  
  ; Government Variables
  tax-rate-firms       ; Firm variabel för att hämta dess tax-rate ; Outdated and will be removed
  tax-rate-households  ; Household variabel för att hämta dess tax-rate ; Outdated and will be removed
  
  
  
  ; Firm Variables
  tax-rate   ; bör använda governments variabel ovan. ; Outdated and will be removed
  machine-fixed-cost
  governemnt-money ; government cut från firm till gov.
  
  
  ; Household Variables
  food-price
  supplies-price
  tax-return-available ; Outdated and will be removed
  tax-return-amount ; Outdated and will be removed
  average-income ; not used rn?
  
  ; Simplicity 
  month ; used for instead of 30 
  year ; used instead of 365
  
  ;----- Time variables, using the time extension, see https://ccl.northwestern.edu/netlogo/docs/time.html
  current-time             ;THE CURRENT TIME IN THE SIMULATION
  start-time               ;START TIME OF THE SIMULATION
  time-passed              ;TEXT STRING SHOWING HOW MUCH TIME HAS BEEN SIMULATED
  weeklyFlag
  dailyFlag
  endOfDay
  ;
  ;------ time library
  agTimer1
  agAlarm1
  ;
  
  ;------ Observer variables
  NrDeceased
  
  ;------ termination variable
  TERMINATE
]
